# ============================================================================
# Exzelon Web — environment variables
# Copy to .env.local and fill in. All values are optional for local dev:
# without RESEND_API_KEY the contact/apply forms log to the server console
# (dev fallback) and still return success so the UX is fully testable.
# ============================================================================

# Resend API key for transactional email (https://resend.com/api-keys)
RESEND_API_KEY=

# Where form submissions are delivered. Defaults to contactus@exzelon.com.
CONTACT_TO_EMAIL=contactus@exzelon.com

# Verified "from" address/domain in Resend. Defaults to Resend's onboarding sender.
CONTACT_FROM_EMAIL="Exzelon Website <onboarding@resend.dev>"

# Public site URL (used for canonical/OG/sitemap). Defaults to https://www.exzelon.com.
# NEXT_PUBLIC_SITE_URL=https://www.exzelon.com

# ----------------------------------------------------------------------------
# Database & auth (required for admin / employer / job-seeker accounts)
# ----------------------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas). Keep the real value ONLY in .env.local.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
# Database name to use within the cluster.
MONGODB_DB="exzelon"
# Secret for signing session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# ----------------------------------------------------------------------------
# Resume storage — Backblaze B2 (S3-compatible API)
# ----------------------------------------------------------------------------
# Use a BUCKET-SCOPED application key (capabilities: listFiles, readFiles,
# writeFiles, deleteFiles, shareFiles) on a PRIVATE bucket — NOT the master key.
# If B2 is unset, resume upload returns 503. Keep secrets only in .env.local / Vercel.
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET="exzelon-resumes"
B2_REGION="us-west-004"
# Optional — defaults to https://s3.<B2_REGION>.backblazeb2.com
# B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"

